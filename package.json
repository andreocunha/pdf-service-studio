{
  "name": "lex-pdf-service",
  "version": "0.1.0",
  "private": true,
  "description": "PDF generator for Lex Studio documents",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:pdf-masks": "tsx scripts/test-pdf-masks.ts",
    "test:pdf-fidelity": "node --import tsx scripts/fidelity/audit.mts",
    "test:pdf-font-failures": "node --import tsx scripts/fidelity/test-font-failures.mts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@sparticuz/chromium": "147.0.0",
    "@supabase/supabase-js": "^2.48.0",
    "fastify": "^5.2.1",
    "pino": "^9.5.0",
    "puppeteer-core": "^24.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
