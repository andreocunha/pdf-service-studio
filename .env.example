# Porta HTTP
PORT=8080

# URL pública do app Next.js (onde está /render-pdf/[id])
# Em dev: http://localhost:3000
# Em prod: https://lexstudio.ai
RENDER_BASE_URL=http://localhost:3000

# Secret HMAC compartilhada entre este serviço e o /render-pdf do app principal
# Gere com: openssl rand -hex 32
PDF_SERVICE_SECRET=change-me-to-a-32-byte-hex

# Supabase (para validar JWT do usuário e consultar workspace_api_keys)
SUPABASE_URL=https://api.lexstudio.ai
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Chromium: deixar vazio em prod (usa @sparticuz/chromium).
# Em dev local: caminho do Chrome instalado. Ex macOS:
#   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_EXECUTABLE_PATH=

# Timeout total por requisição (ms)
REQUEST_TIMEOUT_MS=30000
